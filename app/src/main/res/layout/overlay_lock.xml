<?xml version="1.0" encoding="utf-8"?>
<com.secondbrain.lock.service.BlockingOverlayRoot xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08090B"
    android:orientation="vertical"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="32dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_lock_ring"
        android:layout_marginBottom="28dp">

        <TextView
            android:id="@+id/overlayIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#128274;"
            android:textSize="28sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/overlayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DAILY LIMIT REACHED"
        android:textColor="#FB4F40"
        android:textStyle="bold"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/overlayAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F4F5F7"
        android:textSize="30sp"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="App" />

    <TextView
        android:id="@+id/overlaySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#9EF4F5F7"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="You've used your time for today. This app unlocks automatically at midnight." />

    <LinearLayout
        android:id="@+id/overlayCountdownPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_panel_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_marginTop="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESETS IN"
            android:textColor="#9EF4F5F7"
            android:textSize="11sp"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/overlayCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E0C07E"
            android:textSize="22sp"
            android:fontFamily="serif"
            android:layout_marginTop="4dp"
            android:text="00:00:00" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlayHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_home_pill_bg"
        android:textColor="#08090B"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginTop="36dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="Return to home screen" />

</com.secondbrain.lock.service.BlockingOverlayRoot>
